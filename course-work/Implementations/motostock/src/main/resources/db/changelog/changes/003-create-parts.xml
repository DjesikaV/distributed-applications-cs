<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="003-create-parts" author="motostock">
        <createTable tableName="parts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="sku" type="VARCHAR(40)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>

            <column name="brand" type="VARCHAR(80)">
            </column>

            <column name="category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="supplier_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="quantity" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="purchase_price" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>

            <column name="selling_price" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="parts"
            baseColumnNames="category_id"
            referencedTableName="categories"
            referencedColumnNames="id"
            constraintName="fk_parts_category"
            onDelete="RESTRICT"/>
        <addForeignKeyConstraint
            baseTableName="parts"
            baseColumnNames="supplier_id"
            referencedTableName="suppliers"
            referencedColumnNames="id"
            constraintName="fk_parts_supplier"
            onDelete="RESTRICT"/>
    </changeSet>
</databaseChangeLog>
